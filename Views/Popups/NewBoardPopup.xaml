<?xml version="1.0" encoding="utf-8" ?>

<toolkit:Popup
    x:Class="Quadro_de_pendencias.Views.Popups.NewBoardPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:models="clr-namespace:Quadro_de_pendencias.Models"
    x:TypeArguments="models:BoardModel"
    BackgroundColor="Transparent"
    Padding="0"
    >

    <Border
        Style="{StaticResource popupBorderStyle}">

        <VerticalStackLayout Spacing="20">
            <Label
                Text="Novo Grupo"
                Style="{StaticResource popupTitleLabelStyle}"/>

            <VerticalStackLayout Spacing="8">
                <Entry
                    Placeholder="Nome do quadro"
                    Text="{Binding Title}" />

                <Editor
                    HeightRequest="120"
                    Placeholder="Descrição"
                    Text="{Binding Description}" />
            </VerticalStackLayout>

            <HorizontalStackLayout
                HorizontalOptions="End"
                Spacing="10">

                <Button
                    Text="Cancelar"
                    Command="{Binding CancelCommand}" />

                <Button
                    Text="Salvar"
                    Command="{Binding SaveCommand}" />

            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>