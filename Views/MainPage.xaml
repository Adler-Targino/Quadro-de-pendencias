<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Quadro_de_pendencias.Views.MainPage"
             x:Name="Home"
             xmlns:viewmodels="clr-namespace:Quadro_de_pendencias.ViewModels"
             xmlns:models="clr-namespace:Quadro_de_pendencias.Models"
             xmlns:converters="clr-namespace:Quadro_de_pendencias.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="viewmodels:MainPageViewModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:TruncateStringConverter x:Key="TruncateStringConverter" />
            <converters:InvertBoolConverter x:Key="InvertBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid
        RowDefinitions="*,Auto">
        <Grid
            Grid.Row="0"
            RowDefinitions="Auto,*"
            Padding="30,0"
            RowSpacing="15">

            <!--#region Cabeçalho -->
            <Grid
                Grid.Row="0"
                RowDefinitions="Auto, Auto"
                ColumnDefinitions="*, Auto">

                <Grid
                    Grid.Row="0"
                    Grid.Column="0">

                    <Label
                        Text="{Binding Title}"
                        Style="{StaticResource boardTitleLabelStyle}"
                        IsVisible="{Binding IsEditingTitle, Converter={StaticResource InvertBoolConverter}}">

                        <Label.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding EditBoardTitleCommand}" />
                        </Label.GestureRecognizers>

                    </Label>

                    <Entry
                        Text="{Binding Title}"
                        Style="{StaticResource boardTitleLabelStyle}"
                        IsVisible="{Binding IsEditingTitle}"
                        ReturnType="Done">

                        <Entry.Behaviors>
                            <toolkit:EventToCommandBehavior
                                EventName="Completed"
                                Command="{Binding Source={x:Reference Home},
                                Path=BindingContext.SaveBoardTitleCommand}" />
                        </Entry.Behaviors>

                    </Entry>

                </Grid>

                <Grid
                    Grid.Row="1"
                    Grid.Column="0">

                    <Label
                        Text="{Binding Description}"
                        Style="{StaticResource boardDescriptionLabelStyle}"
                        IsVisible="{Binding IsEditingDescription, Converter={StaticResource InvertBoolConverter}}">

                        <Label.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding EditBoardDescriptionCommand}" />
                        </Label.GestureRecognizers>

                    </Label>

                    <Entry
                        Text="{Binding Description}"
                        Style="{StaticResource boardDescriptionLabelStyle}"
                        IsVisible="{Binding IsEditingDescription}"
                        ReturnType="Done">

                        <Entry.Behaviors>
                            <toolkit:EventToCommandBehavior
                                EventName="Completed"
                                Command="{Binding Source={x:Reference Home},
                                Path=BindingContext.SaveBoardDescriptionCommand}" />
                        </Entry.Behaviors>

                    </Entry>

                </Grid>

                <Button
                    Margin="0,15,0,0"
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource tabButtonStyle}"
                    Text="Apagar Quadro"
                    Command="{Binding DeleteBoardCommand}"
                    CommandParameter="{Binding Board}"/>

                <HorizontalStackLayout
                    Grid.Row="1"
                    Grid.Column="1"
                    Spacing="-10"
                    VerticalOptions="Center">
                    <CheckBox
                        Scale="0.8"
                        VerticalOptions="Center"
                        IsChecked="{Binding HideCompleted, Mode=TwoWay}"/>

                    <Label
                        Text="Ocultar concluídos"
                        Style="{StaticResource cardDescriptionLabelStyle}"
                        VerticalOptions="Center" />

                </HorizontalStackLayout>
            </Grid>
            <!--#endregion-->

            <!--#region Área de grupos -->
            <CollectionView
                Grid.Row="1"
                Margin="0,0,0,15"
                ItemsSource="{Binding Board.Groups}"
                HorizontalOptions="Start"
                HorizontalScrollBarVisibility="Never">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Horizontal"
                        ItemSpacing="10"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:GroupViewModel">
                        <Border Style="{StaticResource groupBorderStyle}">

                            <Border.GestureRecognizers>
                                <DropGestureRecognizer
                                    AllowDrop="True"
                                    DropCommand="{Binding CardDropCommand}" />
                            </Border.GestureRecognizers>

                            <Grid
                                RowDefinitions="4,Auto,*,Auto"
                                VerticalOptions="Start">

                                <BoxView
                                    HeightRequest="4"
                                    Color="{Binding Group.Color}" />

                                <!-- Cabeçalho -->
                                <VerticalStackLayout
                                    Grid.Row="1"
                                    Padding="12"
                                    Spacing="4">

                                    <Grid
                                        RowDefinitions="Auto, Auto"
                                        ColumnDefinitions="Auto, *,Auto">

                                        <Label
                                            Style="{StaticResource groupTitleLabelStyle}"
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Text="{Binding Group.Name}"/>


                                        <Border
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Style="{StaticResource borderHover}">

                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                    Path=BindingContext.DeleteGroupCommand}"
                                                    CommandParameter="{Binding}" />
                                            </Border.GestureRecognizers>

                                            <Image
                                                Source="close.png"
                                                Style="{StaticResource iconImageStyle}">

                                                <Image.Behaviors>
                                                    <toolkit:IconTintColorBehavior
                                                        TintColor="{toolkit:AppThemeResource labelDynamicTextColor}" />
                                                </Image.Behaviors>

                                            </Image>

                                        </Border>

                                        <Label
                                            Style="{StaticResource groupSubTitleLabelStyle}"
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Text="{Binding Cards.Count, StringFormat='Cards: {0} -'}"
                                            VerticalOptions="Center" />

                                        <Label
                                            Style="{StaticResource groupSubTitleLabelStyle}"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Text="{Binding CardCompletionPercentage, StringFormat=' {0} concluído'}"
                                            VerticalOptions="Center" />

                                    </Grid>

                                </VerticalStackLayout>

                                <!-- Lista de Cards -->

                                <CollectionView
                                    Grid.Row="2"
                                    Margin="12,0"
                                    ItemsSource="{Binding VisibleCards}"
                                    SelectionMode="None"
                                    VerticalScrollBarVisibility="Never"
                                    VerticalOptions="Start">

                                    <CollectionView.GestureRecognizers>
                                        <DropGestureRecognizer
                                            AllowDrop="True"
                                            DropCommand="{Binding CardDropCommand}" />
                                    </CollectionView.GestureRecognizers>

                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout Orientation="Vertical"
                                                           ItemSpacing="5"/>
                                    </CollectionView.ItemsLayout>

                                    <CollectionView.ItemTemplate>
                                        <DataTemplate
                                            x:DataType="viewmodels:CardViewModel">

                                            <Border Style="{StaticResource cardBorderStyle}">

                                                <Border.GestureRecognizers>
                                                    <DragGestureRecognizer
                                                        CanDrag="True"
                                                        DragStartingCommand="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}},
                                                        Path=BindingContext.CardDragStartingCommand}"
                                                        DragStartingCommandParameter="{Binding}" />

                                                    <DropGestureRecognizer
                                                        AllowDrop="True"
                                                        DropCommand="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}},
                                                        Path=BindingContext.CardDropCommand}"
                                                        DropCommandParameter="{Binding}" />
                                                </Border.GestureRecognizers>

                                                <Grid
                                                    RowDefinitions="Auto, Auto, Auto"
                                                    ColumnDefinitions="Auto, *"
                                                    RowSpacing="6">

                                                    <CheckBox
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Margin="0,-10,-5,-15"
                                                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                        />

                                                    <Label
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        Style="{StaticResource cardTitleLabelStyle}"
                                                        Text="{Binding Card.Title}">
                                                        <Label.Triggers>
                                                            <DataTrigger
                                                                TargetType="Label"
                                                                Binding="{Binding IsChecked}"
                                                                Value="True">

                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                <Setter Property="Opacity" Value="0.5" />

                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>

                                                    <Label
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        Style="{StaticResource cardDescriptionLabelStyle}"
                                                        Text="{Binding Card.Description}">
                                                        <Label.Triggers>
                                                            <DataTrigger
                                                                TargetType="Label"
                                                                Binding="{Binding IsChecked}"
                                                                Value="True">

                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                <Setter Property="Opacity" Value="0.5" />

                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>

                                                    <Grid
                                                        ColumnDefinitions="*,Auto,Auto"
                                                        Grid.Row="2"
                                                        Grid.Column="1">

                                                        <Label
                                                            Style="{StaticResource cardDateLabelStyle}"
                                                            Text="{Binding Card.DueDate, StringFormat='Vence: {0:dd/MM/yyyy}'}"
                                                            />

                                                        <Border
                                                            Grid.Column="1"
                                                            Style="{StaticResource borderHover}">

                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                                    Path=BindingContext.OpenEditCardModalCommand}"
                                                                    CommandParameter="{Binding}" />
                                                            </Border.GestureRecognizers>

                                                            <Image
                                                                Source="edit.png"
                                                                Style="{StaticResource iconImageStyle}">
                                                                <Image.Behaviors>
                                                                    <toolkit:IconTintColorBehavior
                                                                        TintColor="{toolkit:AppThemeResource labelDynamicTextColor}" />
                                                                </Image.Behaviors>
                                                            </Image>
                                                        </Border>

                                                        <Border
                                                            Grid.Column="2"
                                                            Style="{StaticResource borderHover}">

                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                                    Path=BindingContext.DeleteCardCommand}"
                                                                    CommandParameter="{Binding}" />
                                                            </Border.GestureRecognizers>

                                                            <Image
                                                                Source="trash.png"
                                                                Style="{StaticResource iconImageStyle}">

                                                                <Image.Behaviors>
                                                                    <toolkit:IconTintColorBehavior
                                                                        TintColor="{toolkit:AppThemeResource labelDynamicTextColor}" />
                                                                </Image.Behaviors>
                                                            </Image>
                                                        </Border>
                                                    </Grid>


                                                </Grid>

                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>

                                </CollectionView>


                                <Button
                                    Grid.Row="3"
                                    Style="{StaticResource newCardButtonStyle}"
                                    Text="+ Novo card"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                    Path=BindingContext.OpenNewCardModalCommand}"
                                    CommandParameter="{Binding Group.Id}" />
                            </Grid>

                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <Button
                        Style="{StaticResource newGroupButtonStyle}"
                        Text="+ Novo grupo"
                        Command="{Binding OpenNewGroupModalCommand}" />
                </CollectionView.Footer>

            </CollectionView>


            <!--#endregion-->

        </Grid>

        <!--Rodapé-->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Boards}"
            Margin="30,0,10,15"
            HorizontalOptions="Start"
            HorizontalScrollBarVisibility="Never">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal"
                                   ItemSpacing="5"
                                   />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:BoardViewModel">
                    <Button
                        Style="{StaticResource tabButtonStyle}"
                        Text="{Binding Board.Title,
                        Converter={StaticResource TruncateStringConverter},
                        ConverterParameter=20}"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                        Path=BindingContext.SelectBoardCommand}"
                        CommandParameter="{Binding Board.Id}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <Button
                    Style="{StaticResource tabButtonStyle}"
                    Text="+ Novo quadro"
                    Command="{Binding OpenNewBoardModalCommand}" />
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</ContentPage>
